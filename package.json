{
  "name": "front-web-qa-challenge",
  "version": "1.0.0",
  "description": "Suíte de automação Front Web com Playwright, TypeScript, POM e Allure",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:regression": "playwright test --grep \"@regressao\"",
    "test:smoke": "playwright test --grep \"@smoke\"",
    "test:functional": "playwright test --grep-invert \"@falha\"",
    "test:failure-demo": "playwright test --grep \"@falha\"",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "report:ci": "npm run allure:generate && npm run allure:open"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "playwright",
    "typescript",
    "qa",
    "automation",
    "pom",
    "allure"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "allure-commandline": "^2.29.0",
    "allure-playwright": "^3.0.0",
    "typescript": "^5.0.0"
  }
}